{
  "name": "paayo-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "node scripts/with-android-env.mjs npx expo run:android",
    "android:device": "node scripts/with-android-env.mjs npx expo run:android --device",
    "android:release": "node scripts/with-android-env.mjs npx expo run:android --variant release",
    "android:reverse": "node scripts/with-android-env.mjs adb reverse tcp:44080 tcp:44080",
    "ios": "expo run:ios",
    "ios:device": "expo run:ios --device",
    "ios:release": "expo run:ios --configuration Release",
    "build": "node scripts/build.mjs",
    "build:android": "node scripts/build.mjs --platform android",
    "build:ios": "node scripts/build.mjs --platform ios",
    "build:local": "node scripts/build.mjs --local",
    "prebuild": "expo prebuild --clean",
    "clean": "rm -rf android ios build .expo node_modules/.cache",
    "doctor": "npx expo-doctor",
    "deps:check": "npx expo install --check",
    "deps:fix": "npx expo install --fix",
    "sync": "npm run sync:tokens && npm run sync:icons && npm run sync:logo",
    "sync:tokens": "node scripts/sync-tokens.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "sync:logo": "node scripts/sync-logo.mjs",
    "icons:render": "node scripts/render-icons.mjs",
    "lint": "expo lint --fix",
    "lint:check": "expo lint --max-warnings=0",
    "types:check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "ci": "npm run lint:check && npm run types:check && npm run test:ci"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@rn-primitives/portal": "~1.5.3",
    "@rn-primitives/slot": "~1.5.2",
    "@tabler/icons-react-native": "^3.46.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.15",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.8",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.12",
    "expo-maps": "~57.0.2",
    "expo-media-library": "~57.0.4",
    "expo-notifications": "~57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.13",
    "expo-updates": "~57.0.22",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.33.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-passkeys": "^0.4.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.19.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "prettier": "^3.4.2",
    "react-test-renderer": "19.2.3",
    "simple-icons": "^16.28.0",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|nativewind|react-native-css-interop|lucide-react-native|@tabler/icons-react-native)"
    ]
  }
}
