# The server as the device sees it. Leave unset on a simulator or emulator --
# api.ts already resolves those. A physical phone needs the host's LAN address,
# and the server answering on 0.0.0.0.
EXPO_PUBLIC_API_URL=

# Whether this build was signed by a PAID Apple Developer Program membership.
#
# One flag, not one per feature, because it is one fact about the world. Several
# Apple capabilities are paid -- Associated Domains, which passkeys need, Push
# Notifications, and Sign in with Apple -- and a free Personal Team cannot hold
# any of them.
# Asking for one it cannot hold does not disable that feature: Xcode refuses to
# mint a profile and the WHOLE APP stops building.
#
# So leave it empty if you have no membership. iOS then builds and installs
# exactly as before, with passkeys, push and Apple sign in quietly skipped --
# each has its own support check reading this, so nothing offers a button it
# cannot honour. Android is unaffected by all of this and never reads it.
#
# Set it to anything once you have paid and all three turn on with no code
# change. It is native configuration, so it means `npm run prebuild` and a
# rebuild, not a Metro reload.
EXPO_PUBLIC_APPLE_DEVELOPER_PROGRAM=

# The domain passkeys are bound to, and it is the PRODUCTION domain even for a
# build pointed at a laptop. A passkey binds to a domain, not to an API address:
# both platforms fetch a file from it over HTTPS to decide whether this app may
# speak for it, then send that domain as the origin whatever address the API was
# actually reached on. So an IP or localhost cannot go here -- but the production
# domain can, and does, on a device build against a dev server.
#
# It is not the relying party the ceremony uses; the server decides that, and the
# two must agree. A dev server whose PASSKEY_RP_ID names this domain works;
# one that leaves it empty is its own host instead, and iOS then refuses the
# ceremony. Empty here hides the passkey buttons rather than offering something
# that cannot work.
#
# It drives the iOS Associated Domains entitlement, so changing it means
# `npm run prebuild` and a rebuild.
EXPO_PUBLIC_PASSKEY_DOMAIN=

# The three OAuth clients Google issues tokens against, from one project in the
# Google Cloud console. Ids only -- a mobile OAuth client has no usable secret.
# The server refuses a token minted for a client it does not know, so these must
# match services.google.audiences in its config.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# expo-maps carries Google Maps on Android only -- iOS renders Apple Maps and
# needs no key. Restrict this one to Android apps, this package and the signing
# SHA-1, with no API on it but Maps SDK for Android. The Android map draws the
# unlimited Mobile Native Dynamic Maps SKU, so it costs nothing.
#
# Read into android.config.googleMaps.apiKey at prebuild, not at runtime: a
# change means `npm run prebuild` and a rebuild.
GOOGLE_MAPS_API_KEY=

# The Apple team to sign a release IPA with, used only by `npm run build:ios`.
# Empty produces an UNSIGNED ipa, which is all a free Personal Team can yield and
# is what a sideloader re-signs anyway.
#
# Deliberately not written into app.config.ts: `expo run:ios` passes
# -allowProvisioningUpdates only when it finds no team in the project, so pinning
# one there breaks device builds. See .ai/rules/toolchain.md.
APPLE_TEAM_ID=

# Overrides where prebuild reads the Firebase Android config from. Leave unset
# to use ./google-services.json in this directory, which is the normal case.
# GOOGLE_SERVICES_JSON=
