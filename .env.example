# Apple Developer team the iOS project signs with. Xcode > Settings >
# Apple Accounts shows it; a free Personal Team has one too.
APPLE_TEAM_ID=

# The server as the device sees it. Leave unset on a simulator or emulator --
# api.ts already resolves those. A physical phone needs the host's LAN address,
# and `php artisan serve --host=0.0.0.0` to answer on it.
EXPO_PUBLIC_API_URL=

# The domain a passkey is bound to. It must equal PASSKEY_RP_ID on the server,
# and both platforms fetch a file from it over HTTPS before they will let this
# app speak for it -- so an IP or localhost cannot be used, and it stays empty
# in development. Empty hides the passkey buttons rather than offering
# something that cannot work. It drives the iOS Associated Domains
# entitlement, so changing it means `expo prebuild` and a rebuild, not a
# Metro reload.
EXPO_PUBLIC_PASSKEY_RP_ID=www.paayo.ph

# iOS only, and separate from the domain on purpose. Claiming a domain needs the
# Associated Domains entitlement, which is a PAID Apple Developer Program
# capability -- a free Personal Team is refused, and Xcode fails the whole build
# rather than just passkeys ("Personal development teams ... do not support the
# Associated Domains capability"). Leave it empty until the membership exists:
# iOS then builds and runs as before with the passkey buttons hidden, and
# Android, which needs none of this, keeps working.
EXPO_PUBLIC_PASSKEY_IOS=
