# Apple Developer team the iOS project signs with. Xcode > Settings >
# Apple Accounts shows it; a free Personal Team has one too.
APPLE_TEAM_ID=

# The server as the device sees it. Leave unset on a simulator or emulator --
# api.ts already resolves those. A physical phone needs the host's LAN address,
# and `php artisan serve --host=0.0.0.0` to answer on it.
EXPO_PUBLIC_API_URL=

# The domain a passkey is bound to, matching PASSKEY_RP_ID on the server. Both
# platforms fetch a file from it over HTTPS before they will let this app speak
# for it, so an IP or localhost cannot be used. Leave empty and the passkey
# button hides itself rather than offering something that cannot work.
EXPO_PUBLIC_PASSKEY_RP_ID=
